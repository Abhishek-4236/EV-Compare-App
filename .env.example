APP_ENV=development
PROJECT_NAME=India EV Compare API

# Database. Local manual setup uses localhost. Docker Compose overrides this to use the postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_compare
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ev_compare

# Redis. Used by infrastructure and future distributed rate-limit/cache work.
REDIS_URL=redis://localhost:6379/0

# JWT authentication. Replace this with a long random value before production deployment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional OpenAI provider. Disabled by default so the app can run offline with bundled data.
OPENAI_ENABLED=false
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_QUERY_PARSER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=30

# Optional Groq/Hugging Face hosted model providers.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita
GROQ_MODEL_ENABLED=false
HF_API_KEY=your-huggingface-api-key
HF_MODEL=katanemo/Arch-Router-1.5B:hf-inference
HF_MODEL_ENABLED=false
LLM_TIMEOUT_SECONDS=8
RAG_TOP_K=3

# Optional NVIDIA NeMo Retriever reranker. Keep backend-only; never expose in Vite variables.
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_API_BASE=https://integrate.api.nvidia.com
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-3_2-nv-rerankqa-1b-v2/reranking
NVIDIA_RERANK_ENABLED=false
NVIDIA_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
NVIDIA_RERANK_TIMEOUT_SECONDS=6
NVIDIA_RERANK_MAX_CANDIDATES=20

# Startup helpers.
AUTO_IMPORT_DATA_ON_STARTUP=true
AUTO_OPEN_BROWSER=false
APP_OPEN_URL=http://127.0.0.1:8000/docs

# Dataset and generated retrieval artifacts. These paths are intentionally repo-relative.
EV_EXCEL_PATH=data/raw/India_EV_All_Segments_Dataset_2026_filled.xlsx
EV_JSON_PATH=backend/data/processed/vehicles.json
EV_FAISS_INDEX_PATH=backend/data/processed/vehicles.faiss
EV_FAISS_META_PATH=backend/data/processed/vehicles.meta.json

# CORS origins for local Vite and Docker frontend.
FRONTEND_URL=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Basic in-process backend rate limiting.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_PER_WINDOW=600
RATE_LIMIT_AUTH_PER_WINDOW=60
RATE_LIMIT_CHAT_PER_WINDOW=300
RATE_LIMIT_ADMIN_PER_WINDOW=30

# Admin dataset upload guardrail in bytes.
DATASET_UPLOAD_MAX_BYTES=5000000
