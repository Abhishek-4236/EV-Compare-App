APP_ENV=development

# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_compare
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional AI providers

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita
GROQ_MODEL_ENABLED=false
HF_API_KEY=your-huggingface-api-key
HF_MODEL=katanemo/Arch-Router-1.5B:hf-inference
HF_MODEL_ENABLED=false  
# Optional NVIDIA NeMo Retriever reranker.
# Keep this key backend-only. Do not expose it through Vite/frontend env vars.
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-3_2-nv-rerankqa-1b-v2/reranking
NVIDIA_RERANK_ENABLED=false
NVIDIA_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
NVIDIA_RERANK_TIMEOUT_SECONDS=6
NVIDIA_RERANK_MAX_CANDIDATES=20

# Optional startup behavior
AUTO_IMPORT_DATA_ON_STARTUP=true
AUTO_OPEN_BROWSER=true
APP_OPEN_URL=http://127.0.0.1:8000/docs

# Optional artifact overrides
EV_EXCEL_PATH=data/raw/India_EV_All_Segments_Dataset_2026_filled.xlsx
EV_JSON_PATH=backend/data/processed/vehicles.json
EV_FAISS_INDEX_PATH=backend/data/processed/vehicles.faiss
EV_FAISS_META_PATH=backend/data/processed/vehicles.meta.json

# Optional CORS override
# FRONTEND_URL=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
